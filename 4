import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: ResponsivePage(),
    );
  }
}

class ResponsivePage extends StatelessWidget {
  const ResponsivePage({super.key});

  @override
  Widget build(BuildContext context) {
    // Get screen dimensions
    final size = MediaQuery.of(context).size;
    final width = size.width;
    final height = size.height;

    // Detect device orientation
    final isLandscape =
        MediaQuery.of(context).orientation == Orientation.landscape;

    // Determine number of columns
    final columns = width < 600
        ? (isLandscape ? 2 : 1)
        : width < 1000
            ? 2
            : 3;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Responsive Flutter App'),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),
      body: Padding(
        padding: EdgeInsets.all(width < 600 ? 12 : 24),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Screen Information',
              style: TextStyle(
                fontSize: width < 600 ? 20 : 28,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 8),
            Text('Width: ${width.toStringAsFixed(0)} px'),
            Text('Height: ${height.toStringAsFixed(0)} px'),
            Text(
              'Orientation: ${isLandscape ? "Landscape" : "Portrait"}',
            ),
            const SizedBox(height: 20),
            const Text(
              'Responsive Items',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),
            const SizedBox(height: 12),

            Expanded(
              child: GridView.builder(
                itemCount: 6,
                gridDelegate:
                    SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: columns,
                  crossAxisSpacing: 12,
                  mainAxisSpacing: 12,
                  childAspectRatio: isLandscape ? 1.5 : 1.2,
                ),
                itemBuilder: (context, index) {
                  final colors = [
                    Colors.blue,
                    Colors.green,
                    Colors.orange,
                    Colors.purple,
                    Colors.red,
                    Colors.teal,
                  ];

                  return Card(
                    color: colors[index],
                    child: Center(
                      child: Text(
                        'Item ${index + 1}',
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
